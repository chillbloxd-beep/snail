{
  "name": "study-auth-gateway",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "check": "node --check src/index.js && node scripts/check-project.mjs",
    "hash-password": "node scripts/hash-password.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:create": "wrangler d1 create study_auth_db",
    "d1:apply": "wrangler d1 execute study_auth_db --file=schema.sql --remote"
  },
  "devDependencies": {
    "wrangler": "latest"
  }
}